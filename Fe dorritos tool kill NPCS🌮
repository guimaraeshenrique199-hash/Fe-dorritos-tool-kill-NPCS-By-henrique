local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local backpack = player:WaitForChild("Backpack")

-- ⚙️ CONFIGURAÇÕES
local ASSET_ID = 3420995096
local DORITOS_IMAGE = "rbxassetid://74148139637300"
local DANO_NO_NPC = 20

local MUSIC_IDS = {
    "rbxassetid://130363373001396",
    "rbxassetid://122180189312589",
    "rbxassetid://121351852050830",
    "rbxassetid://133030775976421"
}

local TOOL_NAME = "Doritos"
local SPEED = 40
local RANGE = 50
local COOLDOWN = 0.8

local PROJECTILE_SIZE = Vector3.new(2.5, 2.5, 0.35)

local equipped = false
local busy = false
local currentTool
local toolConnections = {}

--========================================================--
-- VERIFICAR SE É JOGADOR
--========================================================--

local function isPlayerCharacter(model)
    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character == model then
            return true
        end
    end

    return false
end

--========================================================--
-- MÚSICA ALEATÓRIA AO ACERTAR NPC
--========================================================--

local function tocarMusicaNPC()
    local sound = Instance.new("Sound")
    sound.Name = "DoritosHitMusic"
    sound.SoundId = MUSIC_IDS[math.random(1, #MUSIC_IDS)]
    sound.Volume = 1
    sound.Parent = Workspace
    sound:Play()

    sound.Ended:Connect(function()
        sound:Destroy()
    end)

    task.delay(30, function()
        if sound.Parent then
            sound:Destroy()
        end
    end)
end

--========================================================--
-- APLICAR DANO LOCAL AO NPC
--========================================================--

local function aplicarDanoNoNPC(hitPart)
    local model = hitPart:FindFirstAncestorOfClass("Model")
    if not model then
        return false
    end

    if isPlayerCharacter(model) then
        return false
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        return false
    end

    humanoid.Health = math.max(0, humanoid.Health - DANO_NO_NPC)
    return true
end

--========================================================--
-- LOCALIZAR E CARREGAR TOOL
--========================================================--

local function findTool()
    local character = player.Character

    if character then
        local tool = character:FindFirstChild(TOOL_NAME)
        if tool and tool:IsA("Tool") then
            return tool
        end
    end

    local tool = backpack:FindFirstChild(TOOL_NAME)
    if tool and tool:IsA("Tool") then
        return tool
    end

    return nil
end

local function loadDoritos()
    local existing = findTool()
    if existing then
        return existing
    end

    local ok, objects = pcall(function()
        return game:GetObjects("rbxassetid://" .. ASSET_ID)
    end)

    if not ok or not objects or not objects[1] then
        warn("Doritos: não foi possível carregar o asset.")
        return nil
    end

    local container = objects[1]
    local tool

    if container:IsA("Tool") then
        tool = container
    else
        tool = container:FindFirstChildWhichIsA("Tool", true)
    end

    if not tool then
        warn("Doritos: o asset não contém uma Tool.")
        container:Destroy()
        return nil
    end

    tool.Name = TOOL_NAME
    tool.Parent = backpack

    if container ~= tool then
        container:Destroy()
    end

    return tool
end

